# ====================== 配置区（修改结构/参数只改这里） ======================

# LLM 模型配置
# DeepSeek API
DeepSeek_API_KEY=your_api_key
DeepSeek_API_URL=https://api.deepseek.com

# Embedding 模型
EMBEDDING_MODEL_NAME=BAAI/bge-small-zh-v1.5
VEC_DIM=512


# HuggingFace 离线模式（跳过联网检查，直接从缓存加载模型）
# 可选：HuggingFace 离线模式 非首次加载时建议取消注释
# HF_HUB_OFFLINE = 1



# 日志配置
LOG_LEVEL = INFO
LOG_FORMAT = %(asctime)s - %(levelname)s - %(message)s



# 文档预加载配置
# 全局常量：编码兜底优先级，覆盖99%中文场景
ENCODING_TRY_ORDER = ["utf-8", "gb18030", "utf-16", "latin-1"]
ENCODING_DETECTION_BYTES =  "4096"
MIN_CONTENT_LENGTH = "10"
ENCODING_CONFIDENCE = "0.7"
DEFAULT_ENCODING = "utf-8"

# Embedding 模型配置
EMBEDDING_MODEL_NAME = "BAAI/bge-small-zh-v1.5"
VEC_DIM = 512  # 必须和模型输出维度、schema中向量维度三者一致
EMBEDDING_DEVICE = None  # None=自动检测，可选 "cpu"/"cuda"
QUERY_PREFIX = "为这个句子生成表示以用于检索相关文章："  # BGE中文查询前缀

# Milvus 连接配置
AUTO_GET_WIN_HOST_IP = True    # WSL2环境自动获取Windows宿主机IP，设为False则使用下方手动地址
MANUAL_MILVUS_HOST = "xxxxxxxxxxxx"  # 手动指定的Milvus主机地址（自动获取失败时回退）
MILVUS_PORT = "xxxx"
MILVUS_USER = ""  # 有鉴权时填写
MILVUS_PASSWORD = ""  # 有鉴权时填写


# 强制重建开关：设为 True 则每次运行都删除重建，适合频繁改结构的测试阶段
FORCE_REBUILD = False


# 集合核心属性
CONTENT_COLLECTION_NAME = "content_knowledge"
CONTENT_COLLECTION_DESC = "文档内容知识库"
ENABLE_DYNAMIC_FIELD = False
AUTO_ID = False

# https://dev.qweather.com/ 和风天气API
WEATHER_API_KEY = "your_api_key"
WEATHER_API_URL = "your_api_url"

# MySQL（Spec-A）
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=ai_customer
MYSQL_PASSWORD=your_mysql_password
MYSQL_DB=ai_customer_service
MYSQL_ROOT_PASSWORD=your_root_password
MYSQL_DATABASE=ai_customer_service

# JWT（Spec-A）
JWT_SECRET=your_jwt_secret_32plus_chars_random
JWT_EXPIRE_MINUTES=1440

# 问答链路（Spec-B）
PROMPT_OPTIMIZE_ENABLED=1
TOP_K_RETRIEVE=50
TOP_K_RERANK=5
DAILY_QUOTA=100
MAX_QUESTION_LEN=500
CONTEXT_MAX_CHARS=3000
HISTORY_RECENT_TURNS=10
FALLBACK_COPY=抱歉，知识库中暂无相关信息。请尝试换个问法，或联系人工客服获取帮助。
RAG_MIN_COSINE_SIM=0.0   # 检索质量门控（0=关闭；>0 按 1-vector_score 余弦相似度过滤，需校准）

# 加分项（Spec-E）
INTENT_ENABLED=1          # 意图识别总开关（0=不分类、不发 intent 事件、intent 列留 NULL）
INTENT_MODE=hybrid        # rule（零 LLM 成本）/ llm（总是 LLM）/ hybrid（规则优先+LLM 兜底）
INTENT_TIMEOUT=8          # 意图 LLM 兜底超时秒（超时回退默认类，不断流）
FOLLOWUP_ENABLED=1        # 追问建议总开关
FOLLOWUP_SUGGESTION_COUNT=3  # 追问建议条数（解析截断上限）
FOLLOWUP_TIMEOUT=15       # 追问生成超时秒（超时静默跳过，不断流）
SESSION_AUTO_TITLE=1      # 会话自动命名开关（首条消息前 20 字）

# 小说解构（子任务 01：章节切分与原文入库）
NOVEL_CHAPTER_MAX_CHARS=10000   # 超长章节场景切分阈值（字符，≈8k token）
# 小说解构（子任务 02：图骨架与 State）
NOVEL_AGENT_MAX_CONCURRENCY=5   # LangGraph 图最大并发（LLM 限流）
NOVEL_RECURSION_LIMIT=200       # 覆盖默认 25（大书多章 Send 扇出）
NOVEL_AGENT_MAX_SHRINK=2        # 单个 Agent 单场景最大缩窗次数

# 小说解构（顶层计划外：多进程/多机器并发加固-P0）
SNOWFLAKE_WORKER_ID=1   # 雪花 worker_id（0..1023）：单进程默认 1；每进程/每机器必须唯一，防跨进程 ID 碰撞
NOVEL_CHAPTER_LEASE_SECONDS=1800   # 僵死章节租约阈值（秒）：processing 超时未收尾 → 复位 pending 重认领（P0-3）

# 小说解构（子任务 03：实体 Agent 的 llm_runner 分析型配置）
DECONSTRUCT_LLM_TEMPERATURE=0.0   # 解构分析型 LLM 温度（0.1-0.3 低随机，保证结构化抽取稳定）
NOVEL_DECONSTRUCT_ON_UPLOAD=0     # 上传是否默认自动解构（0=否；小说流程前端显式 deconstruct=1）
DECONSTRUCT_LLM_TIMEOUT=120       # 分析型 LLM 超时（秒）
DECONSTRUCT_LLM_MAX_TOKENS=4096   # 分析型 LLM 输出上限

# 内置测试数据初始化（顶层计划外；开发阶段默认开启，置 0 关闭）
SEED_DOCS_ENABLED=1
SEED_DOCS_DIR=../docs/start_files   # 相对 backend/src/；Docker 下由 compose 设为 /app/start_files
